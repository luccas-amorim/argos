{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luccas-amorim/argos/exemplos/lexico.schema.json",
  "title": "Léxico do Argos",
  "description": "Vocabulário declarado em arquivo. O Argos valida e aplica; quem mantém os termos é o repositório consumidor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versao", "termos"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Identificador estável do léxico." },
    "versao": { "type": "string", "minLength": 1, "description": "Data ou versão; vai para cada item da saída." },
    "descricao": { "type": "string" },
    "termos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chave", "formas"],
        "properties": {
          "chave": { "type": "string", "minLength": 1, "description": "Única no léxico; é o que a saída cita." },
          "formas": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Grafias que contam como o termo. Sem distinção de maiúsculas e acentos; palavra inteira."
          },
          "exclusoes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Expressões que, quando contêm a ocorrência, a anulam."
          },
          "peso": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
          "categorias": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Facetas de catalogação (tema, período, tipo de fonte...). Vão para a saída junto com a chave."
          },
          "nota": { "type": "string" }
        }
      }
    },
    "contexto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exige_qualquer"],
      "properties": {
        "exige_qualquer": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Sem ao menos um destes no texto, o item não passa do nível 1."
        },
        "nota": { "type": "string" }
      }
    }
  }
}
